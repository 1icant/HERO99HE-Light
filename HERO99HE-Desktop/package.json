{
  "name": "hero99he-light-desktop",
  "version": "0.3.3",
  "private": true,
  "description": "HERO 99HE local lighting studio with background tray operation",
  "author": "HERO Light Studio",
  "main": "main.cjs",
  "scripts": {
    "prepare-web": "node scripts/sync-web.cjs && node scripts/create-icon.cjs",
    "build-input": "node scripts/build-input.cjs",
    "start": "node scripts/sync-web.cjs && node scripts/build-input.cjs && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "node scripts/sync-web.cjs && node scripts/build-input.cjs && electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.hero99he.lightstudio",
    "productName": "HERO99HE Light Studio",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "policy.cjs", "reactive.cjs", "web/**/*", "assets/**/*", "package.json"],
    "extraResources": [{"from":"native/HeroKeyInput.exe","to":"native/HeroKeyInput.exe"}],
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "HERO99HE-Light-Studio-${version}-win-x64.exe"
    }
  }
}
